# Live execution remains disabled unless later safeguards explicitly authorize it.
LIVE_TRADING_ENABLED=false
PREDICTION_LIVE_ENABLED=false

# Public official endpoint; all credential and operator-specific references stay blank.
ROBINHOOD_MCP_SERVER_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_OAUTH_STORE_DIR=
ROBINHOOD_CRYPTO_API_KEY_FILE=
ROBINHOOD_CRYPTO_PRIVATE_KEY_FILE=

# Restricted files live outside Git, use mode 0600, and are never copied into snapshots.
TRADING_BOT_AUTH_SIGNING_KEY_FILE=
TRADING_BOT_AUTH_VERIFY_KEY_FILE=
TRADING_BOT_ACCOUNT_ALLOWLIST_FILE=
TRADING_BOT_WEBHOOK_URL_FILE=
TRADING_BOT_LLM_API_KEY_FILE=
TRADING_BOT_AGE_RECIPIENT_FILE=
TRADING_BOT_AGE_IDENTITY_FILE=
TRADING_BOT_RCLONE_CONFIG_FILE=

# Deployment, backup, and image references are intentionally operator-supplied.
TRADING_BOT_BACKUP_REMOTE=
TRADING_BOT_IMAGE_DIGEST=
TRADING_BOT_IMAGE=
DEPLOY_HOST=
DEPLOY_USER=
DIGITALOCEAN_TOKEN=
